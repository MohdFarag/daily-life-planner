# Copy to .env for local development.
DATABASE_URL=postgres://planner:planner@localhost:5432/planner
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser (the Android app does not need CORS).
CORS_ORIGINS=http://localhost:5173
MEDIA_DIR=./data/media
# Per-file and per-account media limits (PRD §4.1 open cost decision).
MAX_FILE_BYTES=209715200
USER_QUOTA_BYTES=2147483648
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Google Tasks and Calendar (optional). Create an OAuth client of type "Web application" in Google
# Cloud, add GOOGLE_REDIRECT_URI as an authorised redirect URI, and enable the Tasks and Calendar APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/v1/google/callback
GOOGLE_APP_RETURN_URI=dailylife://google-connected
GOOGLE_SYNC_INTERVAL_SECONDS=300
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Google tokens; keep it secret and stable.
SECRETS_KEY=
