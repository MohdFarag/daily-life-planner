# Copy to .env for local development.
DATABASE_URL=postgres://planner:planner@localhost:5432/planner
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser (the Android app does not need CORS).
CORS_ORIGINS=http://localhost:5173
MEDIA_DIR=./data/media
# Per-file and per-account media limits (PRD §4.1 open cost decision).
MAX_FILE_BYTES=209715200
USER_QUOTA_BYTES=2147483648
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
