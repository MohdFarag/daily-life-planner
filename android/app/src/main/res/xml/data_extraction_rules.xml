<?xml version="1.0" encoding="utf-8"?>
<!-- Personal plans, notes and recordings stay off cloud backups until the app has its own
     account-based sync; device-to-device transfer is allowed so a new phone keeps the data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
