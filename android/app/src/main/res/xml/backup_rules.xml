<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: keep personal plans, notes and recordings out of backups
     (Android 12+ uses data_extraction_rules.xml). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
